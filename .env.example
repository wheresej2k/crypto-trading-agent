# --- Alpaca (paper trading) ---
# Get these from https://app.alpaca.markets/paper/dashboard/overview
# IMPORTANT: use the PAPER keys, not the live-account keys. Free, no payment method needed.
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# --- Watchlist ---
# Comma-separated list of crypto pairs the bot is allowed to trade, in Alpaca's "BASE/QUOTE"
# format. Crypto trades 24/7 - unlike stocks there's no "only liquid during market hours" concern,
# but stick to pairs with real trading volume.
WATCHLIST=BTC/USD,ETH/USD,SOL/USD,LINK/USD,DOGE/USD

# --- Notifications (used by notify.py) ---
# Your carrier's free email-to-MMS gateway address, e.g. 5551234567@vzwpix.com (Verizon),
# 5551234567@tmomail.net (T-Mobile), 5551234567@mypixmessages.com (AT&T).
PHONE_MMS_ADDRESS=your_number@carrier_mms_gateway_here
# A Gmail address + an App Password (NOT your normal Gmail password - generate one at
# https://myaccount.google.com/apppasswords, requires 2-Step Verification to be turned on).
GMAIL_ADDRESS=your_gmail_address_here
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# --- Missed-run alerting (used by watchdog.py) ---
# Same phone/gmail settings above are reused. This threshold controls how many hours can pass
# with no successful trader.py run before the watchdog texts you a warning. The watchdog itself
# checks hourly, so a threshold of 2 catches roughly 2 consecutive missed scheduled runs, not
# just a sustained multi-hour outage.
WATCHDOG_ALERT_AFTER_HOURS=2

# Strategy/risk parameters (SMA windows, stop-loss/take-profit, position/exposure caps, etc.) are
# NOT in this file - they live in config/params.json, which is committed to git (not secret) so
# the automated monthly retune workflow can propose changes to it as a reviewable pull request.
# See README.md for what each parameter means and how they were chosen.
